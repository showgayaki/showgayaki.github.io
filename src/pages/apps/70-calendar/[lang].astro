---
import LegalTemplate from '@/components/legal/LegalTemplate.astro';
import type { LegalDict } from '@/components/legal/LegalTemplate.astro';
import type { Lang } from '@/domain/app/types';

import en from '@/i18n/apps/70-calendar/en';
import ja from '@/i18n/apps/70-calendar/ja';

export function getStaticPaths() {
    return [
        { params: { lang: 'en' } },
        { params: { lang: 'ja' } },
    ];
}

type Props = { lang: Lang };

const routeParams = Astro.params as Partial<{ lang: Lang }>;
const props = Astro.props as Partial<Props>;
const lang = (routeParams.lang ?? props.lang) as Lang;

let dict: LegalDict;
let description: string;
switch (lang) {
    case 'en':
        dict = en;
        description = '70! Calendar is a Google Calendar client app for iOS and macOS.';
        break;
    case 'ja':
        dict = ja;
        description = '70! カレンダーは、iOS・macOS向けのGoogleカレンダークライアントアプリです。';
        break;
    default: throw new Error(`Unknown lang: ${lang}`);
}

const metadata = { title: dict.title, description };

// 言語なしの URL (index.astro) から表示された場合も、言語付きの URL を正規 URL にする
const canonicalPath = `/apps/70-calendar/${lang}`;
---

<LegalTemplate dict={dict} metadata={metadata} lang={lang} canonicalPath={canonicalPath} />
