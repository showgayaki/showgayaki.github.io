---
import type { PageMetadata } from '@/domain/app/metadata';
import type { Lang } from '@/domain/app/types';

import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/style.scss';

type Props = {
    metadata: PageMetadata;
    lang?: Lang;
    mainClass?: string;
    hideChrome?: boolean;
    noindex?: boolean;
};

// hideChrome: ヘッダー・フッターを表示しない、noindex: 検索エンジンにインデックスさせない
const { metadata, lang = 'ja', mainClass = '', hideChrome = false, noindex = false } = Astro.props;
---

<html lang={lang}>
    <head>
        <BaseHead metadata={metadata} lang={lang} noindex={noindex} />
    </head>
    <body>
        {!hideChrome && <Header />}
        <main class:list={['container', mainClass]}>
            <slot />
        </main>
        {!hideChrome && <Footer />}
    </body>
</html>
