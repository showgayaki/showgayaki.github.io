---
import { siteMetadata } from '@/metadata';

import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/style.scss';

// hideChrome: ヘッダー・フッターを表示しない、noindex: 検索エンジンにインデックスさせない
const { mainClass = '', hideChrome = false, noindex = false } = Astro.props;
// 末尾のスラッシュ削除（ただしルートパスは除く）
// ビルド時は build.format: 'file' によりパスが .html 付きになるため、それも削除する
const normalizePath = (p?: string) => {
    if (!p) return '/';
    if (p === '/') return '/';
    return p.replace(/\.html$/, '').replace(/\/+$/, '');
};

const normalizedPage = normalizePath(Astro.url.pathname);
const pageMetadata = siteMetadata[normalizedPage] ?? siteMetadata['/'];
---

<html>
    <head>
        <BaseHead metadata={pageMetadata} noindex={noindex} />
    </head>
    <body>
        {!hideChrome && <Header />}
        <main class:list={['container', mainClass]}>
            <slot />
        </main>
        {!hideChrome && <Footer />}
    </body>
</html>
