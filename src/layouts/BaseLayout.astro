---
import type { PageMetadata } from '@/domain/app/metadata';
import type { Lang } from '@/domain/app/types';

import BaseHead from '@/components/BaseHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/style.scss';

type Props = {
    metadata: PageMetadata;
    lang?: Lang;
    mainClass?: string;
    hideChrome?: boolean;
    noindex?: boolean;
    canonicalPath?: string;
};

// hideChrome: ヘッダー・フッターを表示しない、noindex: 検索エンジンにインデックスさせない
// canonicalPath: 正規 URL のパス。省略時はアクセスされたパスを使う
const { metadata, lang = 'ja', mainClass = '', hideChrome = false, noindex = false, canonicalPath } = Astro.props;
---

<html lang={lang}>
    <head>
        <BaseHead metadata={metadata} lang={lang} noindex={noindex} canonicalPath={canonicalPath} />
    </head>
    <body>
        {!hideChrome && <Header />}
        <main class:list={['container', mainClass]}>
            <slot />
        </main>
        {!hideChrome && <Footer />}
    </body>
</html>
