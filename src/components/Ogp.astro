---
import type { PageMetadata } from '../domain/app/metadata';
import type { Lang } from '../domain/app/types';

type Props = { siteTitle: string, metadata: PageMetadata, lang: Lang, url: string };

const { siteTitle, metadata, lang, url } = Astro.props;

const LOCALES: Record<Lang, string> = { ja: 'ja_JP', en: 'en_US' };
---

<!-- OGP -->
<meta property="og:type" content="website">
<meta property="og:title" content=`${siteTitle} - ${metadata.title}`>
<meta property="og:description" content={metadata.description}>
<meta property="og:url" content={url}>
<meta property="og:image" content=`${Astro.url.origin}/ogp.png`>
<meta property="og:site_name" content={siteTitle}>
<meta property="og:locale" content={LOCALES[lang]}>
<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={siteTitle}>
<meta name="twitter:description" content={metadata.description}>
<meta name="twitter:image" content=`${Astro.url.origin}/ogp.png`>
<link rel="canonical" href={url}>
